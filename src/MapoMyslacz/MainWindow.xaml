<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MapoMyslacz.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:MapoMyslacz.Editor"
    Title="MapoMyślacz">

    <Grid x:Name="RootHost" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="MinWidth" Value="36" />
            </Style>
            <Style x:Key="ToolDropDown" TargetType="DropDownButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Margin" Value="1,0" />
            </Style>
            <Style x:Key="ToolIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- pasek tytułu (cały służy do przeciągania okna) -->
        <Grid x:Name="TitleBar" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" Margin="14,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="MapoMyślacz" />
        </Grid>

        <!-- pasek narzędzi -->
        <Grid Grid.Row="1" Padding="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Click="Back_Click" Visibility="Collapsed"
                        ToolTipService.ToolTip="Wróć do poprzedniej mapy (Alt+←)">
                    <FontIcon Glyph="&#xE72B;" Style="{StaticResource ToolIcon}" />
                </Button>
                <DropDownButton x:Name="FileButton" Style="{StaticResource ToolDropDown}" ToolTipService.ToolTip="Plik">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Plik" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="FileMenu" Placement="BottomEdgeAlignedLeft" Opening="FileMenu_Opening">
                            <MenuFlyoutItem Text="Nowa mapa" Click="New_Click" KeyboardAcceleratorTextOverride="Ctrl+N">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Otwórz…" Click="Open_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="RecentMenu" Text="Ostatnio otwierane">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Zapisz" Click="Save_Click" KeyboardAcceleratorTextOverride="Ctrl+S">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Zapisz jako…" Click="SaveAs_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Importuj z XMind…" Click="ImportXmind_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Eksportuj obraz PNG…" Click="ExportPng_Click" KeyboardAcceleratorTextOverride="Ctrl+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Eksportuj PDF…" Click="ExportPdf_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA90;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Drukuj…" Click="Print_Click" KeyboardAcceleratorTextOverride="Ctrl+P">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Zamknij" Click="Exit_Click" KeyboardAcceleratorTextOverride="Alt+F4">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BB;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <AppBarSeparator />
                <Button Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTipService.ToolTip="Cofnij (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Redo_Click" ToolTipService.ToolTip="Ponów (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIcon}" />
                </Button>
                <AppBarSeparator />
                <Button Style="{StaticResource ToolButton}" Click="AddFloating_Click" ToolTipService.ToolTip="Nowy kafelek (albo dwuklik na pustym miejscu)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Kafelek" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="AddChild_Click" ToolTipService.ToolTip="Dodaj dziecko (Tab)">
                    <FontIcon Glyph="&#xE8B4;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="AddSibling_Click" ToolTipService.ToolTip="Dodaj rodzeństwo (Enter)">
                    <FontIcon Glyph="&#xE8FD;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Connect_Click" ToolTipService.ToolTip="Połącz strzałką (Ctrl+L) — albo przeciągnij kółko „+” przy zaznaczonym kafelku">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72A;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Strzałka" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTipService.ToolTip="Usuń zaznaczone (Delete)">
                    <FontIcon Glyph="&#xE74D;" Style="{StaticResource ToolIcon}" />
                </Button>
                <AppBarSeparator />
                <DropDownButton x:Name="StyleButton" Style="{StaticResource ToolDropDown}" ToolTipService.ToolTip="Gotowe style kafelków">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Styl" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="StyleMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{StaticResource ToolButton}" Click="Arrange_Click" ToolTipService.ToolTip="Uporządkuj gałęzie (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A9;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Uporządkuj" />
                    </StackPanel>
                </Button>
                <AppBarSeparator />
                <DropDownButton Style="{StaticResource ToolDropDown}" ToolTipService.ToolTip="Druk i eksport">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" Style="{StaticResource ToolIcon}" />
                        <TextBlock Text="Drukuj" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Drukuj…" Click="Print_Click" KeyboardAcceleratorTextOverride="Ctrl+P">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Zapisz jako PDF…" Click="ExportPdf_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA90;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Zapisz jako obraz PNG…" Click="ExportPng_Click" KeyboardAcceleratorTextOverride="Ctrl+E">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Oddal (Ctrl+−)">
                    <FontIcon Glyph="&#xE71F;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button x:Name="ZoomButton" Style="{StaticResource ToolButton}" Click="Zoom100_Click" MinWidth="58" ToolTipService.ToolTip="Powiększenie — kliknij, żeby wrócić do 100% (Ctrl+1)">
                    <TextBlock x:Name="ZoomText" Text="100%" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Przybliż (Ctrl++)">
                    <FontIcon Glyph="&#xE8A3;" Style="{StaticResource ToolIcon}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Fit_Click" ToolTipService.ToolTip="Pokaż całą mapę (Ctrl+0)">
                    <FontIcon Glyph="&#xE9A6;" Style="{StaticResource ToolIcon}" />
                </Button>
                <AppBarSeparator />
                <ToggleButton x:Name="PanelToggle" Background="Transparent" BorderBrush="Transparent"
                              Padding="9,7" IsChecked="True" Click="PanelToggle_Click" ToolTipService.ToolTip="Panel właściwości">
                    <FontIcon Glyph="&#xE8A0;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>
                <DropDownButton Style="{StaticResource ToolDropDown}" ToolTipService.ToolTip="Pomoc i aktualizacje">
                    <FontIcon Glyph="&#xE897;" Style="{StaticResource ToolIcon}" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Skróty i obsługa myszy" Click="Help_Click" KeyboardAcceleratorTextOverride="F1">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CheckUpdateButton" Text="Sprawdź aktualizacje" Click="CheckUpdateNow_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="AutoUpdateCheck" Text="Sprawdzaj automatycznie przy starcie" Click="AutoUpdate_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="O programie" Click="About_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- płótno + panel właściwości -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <editor:MapCanvas x:Name="Map" />
            </Border>

            <!-- komunikaty na nieprzezroczystym tle (półprzezroczyste InfoBary były niewidoczne na białym płótnie
                 w ciemnym motywie: biały tekst na bieli) -->
            <Border x:Name="UpdateHost" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" MaxWidth="680"
                    Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateActionButton" Content="Zaktualizuj" Click="UpdateAction_Click" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <HyperlinkButton x:Name="UpdateNotesLink" Content="Co nowego?" Click="UpdateNotes_Click" />
                            <HyperlinkButton x:Name="UpdateSkipLink" Content="Pomiń tę wersję" Click="UpdateSkip_Click" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
            </Border>

            <Border x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="640"
                    Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <InfoBar x:Name="Toast" IsOpen="False" IsClosable="True" Severity="Success" />
            </Border>

            <Border x:Name="PropsPanel" Grid.Column="1" Width="300" BorderThickness="1,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropsHost" Padding="16,14,16,20" Spacing="6" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- pasek stanu -->
        <Grid Grid.Row="3" Height="28" Padding="12,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"
                       Margin="0,0,200,0" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.7" />
        </Grid>
    </Grid>
</Window>
